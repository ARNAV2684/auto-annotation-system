# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

# Override the config device if desired (auto | cuda | cpu)
SAM_DEVICE=auto

# Backend server (Sprint 4)
API_HOST=0.0.0.0
API_PORT=8000

# Frontend dev server origin, for CORS (Sprint 5)
FRONTEND_ORIGIN=http://localhost:5173

# Path to config file (defaults to ./config.yaml)
CONFIG_PATH=config.yaml
