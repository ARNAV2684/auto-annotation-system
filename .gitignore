# ─── Python ───
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ─── Virtual environments ───
.venv/
venv/
env/

# ─── Environment / secrets ───
.env
*.env
!.env.example

# ─── Model weights (large binaries — never commit) ───
models/sam_checkpoints/*
!models/sam_checkpoints/.gitkeep
*.pt
*.pth
*.onnx

# ─── Training outputs (Sprint 7) — runs, weights, generated splits ───
models/road_defects/
runs/

# ─── Data outputs / scratch ───
# Everything under data/ is local-only by default — drone imagery, reference
# videos, training datasets, and any pre-labelled exports stay on the dev
# machine. The placeholder .gitkeep files exist so the empty folder skeleton
# is checked in.
data/*
!data/.gitkeep
!data/sample_images
!data/sample_annotations
data/sample_images/*
!data/sample_images/.gitkeep
data/sample_annotations/*
!data/sample_annotations/.gitkeep
outputs/
*.zip

# ─── Frontend (Node) ───
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local
frontend/.eslintcache

# ─── Local-only / private (never commit, never push) ───
CLAUDE.md
CLAUDE.local.md
PROJECT_JOURNAL.md

# ─── Tooling / IDE / OS ───
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/
.idea/
.vscode/
.DS_Store
Thumbs.db
